<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddPlaceholderFileToPackage</TargetsForTfmSpecificContentInPackage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\Photinizer.Build.VueJS.props" Pack="true" PackagePath="build\" />
    <None Include="build\Photinizer.Build.VueJS.targets" Pack="true" PackagePath="build\" />
    <None Include="Frontend\**\*.js" Pack="true" PackagePath="Frontend" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photinizer.Cli" Version="0.1.0">
      <GeneratePathProperty>true</GeneratePathProperty>
      <IncludeAssets>compile;runtime;build;native;contentfiles;analyzers;buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="_AddPlaceholderFileToPackage">
    <WriteLinesToFile File="$(IntermediateOutputPath)_._" Lines="" Overwrite="true" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)_._" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>