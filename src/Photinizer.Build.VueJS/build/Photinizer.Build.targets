<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Compute path to CLI inside Photinizer.Cli package -->
  <PropertyGroup>
    <!-- $(PkgPhotinizer_Cli) is generated by MSBuild for PackageReference Include="Photinizer.Cli" -->
    <PhotinizerCliDir>$(PkgPhotinizer_Cli)\tools\net8.0\any</PhotinizerCliDir>
    <PhotinizerCliDll>$(PhotinizerCliDir)\Photinizer.Cli.dll</PhotinizerCliDll>

    <!-- Allow override from consumer project -->
    <PhotinizerCliOverride Condition="'$(PhotinizerCliOverride)'!=''">$(PhotinizerCliOverride)</PhotinizerCliOverride>
    <_PhotinizerCliToRun Condition="'$(PhotinizerCliOverride)'!=''">$(PhotinizerCliOverride)</_PhotinizerCliToRun>
    <_PhotinizerCliToRun Condition="'$(_PhotinizerCliToRun)'==''">$(PhotinizerCliDll)</_PhotinizerCliToRun>

    <!-- Default bundler args -->
    <PhotinizerBundlerArgs Condition="'$(PhotinizerBundlerArgs)'==''">
      --build-source "$(MSBuildProjectDirectory)" --out "$(PhotinizerBundlerOut)"
    </PhotinizerBundlerArgs>
  </PropertyGroup>

  <!-- Run after Build (single-TFM, non-design-time, enabled) -->
  <Target Name="Photinizer_Bundle_OnBuild"
          AfterTargets="Build"
          Condition="
            '$(PhotinizerEnableBundler)'=='true' and
            '$(PhotinizerBundleOnBuild)'=='true' and
            '$(IsCrossTargetingBuild)'!='true' and
            '$(DesignTimeBuild)'!='true' and
            '$(Configuration)'=='$(PhotinizerBundleConfiguration)'">

    <Message Text="Photinizer: running bundler (OnBuild) via: dotnet '$(_PhotinizerCliToRun)' $(PhotinizerBundlerArgs)" Importance="high" />

    <Exec Command='dotnet "$(_PhotinizerCliToRun)" $(PhotinizerBundlerArgs)'
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

  <!-- Or before Publish -->
  <Target Name="Photinizer_Bundle_OnPublish"
          BeforeTargets="Publish"
          Condition="
            '$(PhotinizerEnableBundler)'=='true' and
            '$(PhotinizerBundleOnPublish)'=='true' and
            '$(IsCrossTargetingBuild)'!='true' and
            '$(DesignTimeBuild)'!='true'">

    <Message Text="Photinizer: running bundler (OnPublish) via: dotnet '$(_PhotinizerCliToRun)' $(PhotinizerBundlerArgs)" Importance="high" />

    <Exec Command='dotnet "$(_PhotinizerCliToRun)" $(PhotinizerBundlerArgs)'
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

</Project>