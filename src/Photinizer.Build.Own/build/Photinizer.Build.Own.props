<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- enable bundler by default -->
    <PhotinizerEnableBundler Condition="'$(PhotinizerEnableBundler)'==''">true</PhotinizerEnableBundler>

    <!-- run after Build by default -->
    <PhotinizerBundleOnBuild Condition="'$(PhotinizerBundleOnBuild)'==''">true</PhotinizerBundleOnBuild>

    <!-- do not run on Publish by default -->
    <PhotinizerBundleOnPublish Condition="'$(PhotinizerBundleOnPublish)'==''">false</PhotinizerBundleOnPublish>

    <!-- default out dir -->
    <PhotinizerBundlerOut Condition="'$(PhotinizerBundlerOut)'==''">$(OutDir)</PhotinizerBundlerOut>

    <!-- default CLI args -->
    <PhotinizerBundlerArgs Condition="'$(PhotinizerBundlerArgs)'==''">
      --build-source "$(MSBuildProjectDirectory)" --out "$(PhotinizerBundlerOut)"
    </PhotinizerBundlerArgs>
  </PropertyGroup>
</Project>