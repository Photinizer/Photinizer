{
  "contentRoot": "Content",
  "Photinizer": {
    "Windows": {

      "Main": {
        "Source": "main.html",
        "Title": "Main Window",
        "Window": {
          "UseOsDefaultSize": false,
          "Width": 600,
          "Height": 400,
          "Center": true,
          "DevToolsEnabled": false
        },
        "UI": {
          "RootComponent": "MainView"
        }
      },

      "Login": {
        "Source": "login.html",
        "Title": "Login Window",
        "Window": {
          "UseOsDefaultSize": true,
          "Center": true,
          "DevToolsEnabled": false
        },
        "UI": {
          "RootComponent": "LoginView"
        }
      },

      "Secondary": {
        "Source": "secondary.html",
        "Title": "Secondary Window",
        "Window": {
          "UseOsDefaultSize": false,
          "Width": 800,
          "Height": 600,
          "UseOsDefaultLocation": true,
          "DevToolsEnabled": false
        },
        "UI": {
          "RootComponent": "SecondaryView"
        }
      }

    }
  }
}